{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Facetomyself/reverse_ENV/contracts/web-reverse/evidence-pointer.v1.schema.json",
  "title": "Web evidence pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "caseId",
    "plane",
    "runId",
    "artifactId",
    "path",
    "sha256",
    "bytes",
    "mediaType",
    "sensitivity",
    "redaction"
  ],
  "properties": {
    "schema": {"const": "evidence-pointer.v1"},
    "caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
    "plane": {"enum": ["ruyi-control", "ruyitrace", "v8trace", "iv8", "ruyidom", "parity"]},
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
    "artifactId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,95}$"},
    "path": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^evidence/web/(handoff|ruyitrace|v8trace|iv8|parity)/[a-z0-9][a-z0-9_-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "mediaType": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"},
    "recordCount": {"type": "integer", "minimum": 0},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["json-pointer", "line-range", "record-range", "sqlite-row"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "cursor": {"type": "string", "minLength": 1, "maxLength": 2048},
    "sensitivity": {"enum": ["public-synthetic", "private-redacted", "private-raw"]},
    "redaction": {"enum": ["not-applicable", "synthetic", "allowlist-summary", "manual-reviewed"]}
  },
  "allOf": [
    {
      "if": {"properties": {"plane": {"const": "ruyi-control"}}, "required": ["plane"]},
      "then": {"properties": {"path": {"type": "string", "pattern": "^evidence/web/handoff/"}}}
    },
    {
      "if": {"properties": {"plane": {"const": "ruyitrace"}}, "required": ["plane"]},
      "then": {"properties": {"path": {"type": "string", "pattern": "^evidence/web/ruyitrace/"}}}
    },
    {
      "if": {"properties": {"plane": {"const": "v8trace"}}, "required": ["plane"]},
      "then": {"properties": {"path": {"type": "string", "pattern": "^evidence/web/v8trace/"}}}
    },
    {
      "if": {"properties": {"plane": {"const": "iv8"}}, "required": ["plane"]},
      "then": {"properties": {"path": {"type": "string", "pattern": "^evidence/web/iv8/"}}}
    },
    {
      "if": {"properties": {"plane": {"const": "parity"}}, "required": ["plane"]},
      "then": {"properties": {"path": {"type": "string", "pattern": "^evidence/web/parity/"}}}
    }
  ]
}

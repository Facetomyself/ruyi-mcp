{
  "snapshotVersion": 1,
  "tools": [
    {
      "description": "通过 Firefox WebDriver BiDi 端口接管已启动的浏览器，不新建进程、不导航页面，MCP 退出或 bridge 超时时保留外部浏览器。",
      "inputSchema": {
        "properties": {
          "address": {
            "default": "127.0.0.1",
            "description": "监听地址，默认 127.0.0.1",
            "type": "string"
          },
          "port": {
            "description": "Firefox --remote-debugging-port",
            "maximum": 65535,
            "minimum": 1,
            "type": "number"
          },
          "profilePath": {
            "description": "现有 Firefox profile 绝对路径（可选）",
            "type": "string"
          },
          "traceEnabled": {
            "default": false,
            "description": "接管后启用 BiDi trace，默认 false",
            "type": "boolean"
          }
        },
        "required": [
          "port"
        ],
        "type": "object"
      },
      "name": "ruyi_attach_browser"
    },
    {
      "description": "在 XHR/Fetch 请求 URL 匹配时触发断点（注入 debugger）。等价于 ruyi_set_breakpoint_on_text with XHR wrapper.",
      "inputSchema": {
        "properties": {
          "pageIdx": {
            "default": 0,
            "type": "number"
          },
          "url": {
            "description": "URL 匹配片段（子串匹配）",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "name": "ruyi_break_on_xhr"
    },
    {
      "description": "关闭由 MCP 启动的浏览器并清理状态；端口接管的外部浏览器只断开连接，不关闭进程。",
      "inputSchema": {
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "ruyi_browser_quit"
    },
    {
      "description": "获取浏览器当前状态：是否存活、当前 URL、页面数量、断点数、preload 脚本数。",
      "inputSchema": {
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "ruyi_browser_status"
    },
    {
      "description": "开始被动抓包。按 URL 模式匹配请求，后续用 ruyi_capture_wait 获取。",
      "inputSchema": {
        "properties": {
          "method": {
            "description": "仅匹配 HTTP 方法（GET/POST/...）",
            "type": "string"
          },
          "pageIdx": {
            "default": 0,
            "type": "number"
          },
          "pattern": {
            "default": "",
            "description": "URL 匹配模式（子串匹配）",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "ruyi_capture_start"
    },
    {
      "description": "停止被动抓包。会先清空尚未消费的队列/历史，避免 ruyiPage stop 隐式补读全部 body；需要结果时应先调用 ruyi_capture_wait。",
      "inputSchema": {
        "properties": {
          "cleanupTimeout": {
            "default": 5,
            "description": "每个 BiDi 清理命令的超时秒数，默认 5，范围 0.1–30",
            "maximum": 30,
            "minimum": 0.1,
            "type": "number"
          },
          "pageIdx": {
            "default": 0,
            "type": "number"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "ruyi_capture_stop"
    },
    {
      "description": "等待并获取抓包结果。在调用 ruyi_capture_start 后使用。默认返回完整 request/response body；内部按单包 RPC 排空，避免大批量补读拖垮 bridge。",
      "inputSchema": {
        "properties": {
          "count": {
            "default": 5,
            "description": "期望捕获的请求数，默认 5",
            "type": "number"
          },
          "maxBodyChars": {
            "default": 0,
            "description": "每个 request/response body 的显式字符上限；0 表示不截断，默认 0",
            "minimum": 0,
            "type": "number"
          },
          "pageIdx": {
            "default": 0,
            "type": "number"
          },
          "timeout": {
            "default": 10,
            "description": "等待超时（秒），默认 10",
            "type": "number"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "ruyi_capture_wait"
    },
    {
      "description": "清除当前页面的浏览器状态：Cookie、localStorage、sessionStorage。",
      "inputSchema": {
        "properties": {
          "pageIdx": {
            "default": 0,
            "type": "number"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "ruyi_clear_site_data"
    },
    {
      "description": "关闭指定标签页。不能关闭主标签页（pageIdx=0）。",
      "inputSchema": {
        "properties": {
          "pageIdx": {
            "default": 1,
            "description": "要关闭的标签页索引",
            "type": "number"
          }
        },
        "required": [
          "pageIdx"
        ],
        "type": "object"
      },
      "name": "ruyi_close_page"
    },
    {
      "description": "删除 cookies。不传 name 则清除所有 cookies。",
      "inputSchema": {
        "properties": {
          "name": {
            "description": "要删除的 cookie 名称。不传则清除全部。",
            "type": "string"
          },
          "pageIdx": {
            "default": 0,
            "description": "标签页索引",
            "type": "number"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "ruyi_delete_cookies"
    },
    {
      "description": "点击 DOM 元素。",
      "inputSchema": {
        "properties": {
          "pageIdx": {
            "default": 0,
            "type": "number"
          },
          "selector": {
            "description": "目标元素选择器",
            "type": "string"
          }
        },
        "required": [
          "selector"
        ],
        "type": "object"
      },
      "name": "ruyi_dom_click"
    },
    {
      "description": "读取 DOM 元素的文本内容、HTML、表单值和指定属性。",
      "inputSchema": {
        "properties": {
          "attribute": {
            "description": "要读取的属性名（如 href, src, data-*）",
            "type": "string"
          },
          "pageIdx": {
            "default": 0,
            "type": "number"
          },
          "selector": {
            "description": "元素选择器",
            "type": "string"
          }
        },
        "required": [
          "selector"
        ],
        "type": "object"
      },
      "name": "ruyi_dom_get_info"
    },
    {
      "description": "向 DOM 元素输入文本或上传文件。支持普通文本输入和文件路径上传。",
      "inputSchema": {
        "properties": {
          "clear": {
            "default": true,

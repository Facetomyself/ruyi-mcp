          }
        },
        "required": [
          "timezoneId"
        ],
        "type": "object"
      },
      "name": "ruyi_emulate_timezone"
    },
    {
      "description": "模拟浏览器 UserAgent 字符串。覆盖 navigator.userAgent。",
      "inputSchema": {
        "properties": {
          "pageIdx": {
            "default": 0,
            "type": "number"
          },
          "userAgent": {
            "description": "自定义 UserAgent 字符串",
            "type": "string"
          }
        },
        "required": [
          "userAgent"
        ],
        "type": "object"
      },
      "name": "ruyi_emulate_useragent"
    },
    {
      "description": "在浏览器页面中执行 JavaScript 函数并返回结果。可用于运行时采样、Hook 注入、读取页面状态。函数必须返回 JSON-safe 值。支持接收本地文件作为参数。",
      "inputSchema": {
        "properties": {
          "function": {
            "description": "要执行的 JavaScript 函数声明。例: \"() => { return document.title }\" 或 \"async () => { return await fetch('example.com') }\"",
            "type": "string"
          },
          "pageIdx": {
            "default": 0,
            "description": "标签页索引，默认当前活跃页",
            "type": "number"
          },
          "sandbox": {
            "description": "BiDi sandbox 名称（隔离执行上下文）",
            "type": "string"
          },
          "timeout": {
            "default": 10,
            "description": "超时（秒），默认 10",
            "type": "number"
          }
        },
        "required": [
          "function"
        ],
        "type": "object"
      },
      "name": "ruyi_evaluate_script"
    },
    {
      "description": "导出当前浏览器会话状态（Cookie、localStorage、sessionStorage、UserAgent、URL）。可保存到 JSON 文件供 js-reverse-mcp、ruyitrace 或其他工具复用。这是跨工具 session 桥接的核心工具。",
      "inputSchema": {
        "properties": {
          "include": {
            "default": [
              "cookies",
              "localStorage",
              "sessionStorage"
            ],
            "description": "要导出的内容类型",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "outputFile": {
            "description": "保存到的 JSON 文件路径（绝对路径）。不提供则直接返回内容。",
            "type": "string"
          },
          "pageIdx": {
            "default": 0,
            "description": "标签页索引",
            "type": "number"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "ruyi_export_session"
    },
    {
      "description": "获取当前页面的所有 cookies。",

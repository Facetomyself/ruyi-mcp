            "type": "boolean"
          },
          "pageIdx": {
            "default": 0,
            "type": "number"
          },
          "selector": {
            "description": "目标元素选择器",
            "type": "string"
          },
          "text": {
            "description": "要输入的文本内容",
            "type": "string"
          }
        },
        "required": [
          "selector",
          "text"
        ],
        "type": "object"
      },
      "name": "ruyi_dom_input"
    },
    {
      "description": "在页面中定位 DOM 元素。支持 CSS 选择器、XPath、标签名、文本内容等多种定位方式。格式: \"#id\" / \"css:.class\" / \"xpath://div\" / \"tag:input\" / \"text:登录\"",
      "inputSchema": {
        "properties": {
          "pageIdx": {
            "default": 0,
            "type": "number"
          },
          "selector": {
            "description": "元素选择器。支持：#id, css:.class, xpath://div, tag:input, text:登录",
            "type": "string"
          },
          "timeout": {
            "default": 10,
            "description": "等待超时（秒），默认 10",
            "type": "number"
          }
        },
        "required": [
          "selector"
        ],
        "type": "object"
      },
      "name": "ruyi_dom_select"
    },
    {
      "description": "模拟浏览器地理位置（经纬度）。",
      "inputSchema": {
        "properties": {
          "accuracy": {
            "default": 100,
            "description": "精度（米），默认 100",
            "type": "number"
          },
          "latitude": {
            "description": "纬度",
            "type": "number"
          },
          "longitude": {
            "description": "经度",
            "type": "number"
          },
          "pageIdx": {
            "default": 0,
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object"
      },
      "name": "ruyi_emulate_geolocation"
    },
    {
      "description": "模拟浏览器语言/区域。",
      "inputSchema": {
        "properties": {
          "locale": {
            "description": "语言区域代码，如 \"en-US\", \"zh-CN\"",

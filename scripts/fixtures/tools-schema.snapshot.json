          },
          "pageIdx": {
            "default": 0,
            "type": "number"
          }
        },
        "required": [
          "locale"
        ],
        "type": "object"
      },
      "name": "ruyi_emulate_locale"
    },
    {
      "description": "模拟浏览器时区。",
      "inputSchema": {
        "properties": {
          "pageIdx": {
            "default": 0,
            "type": "number"
          },
          "timezoneId": {
            "description": "IANA 时区，如 \"Asia/Tokyo\"",

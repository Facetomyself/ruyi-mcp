{
  "name": "ruyi-mcp",
  "version": "0.2.0-reverse-env.2",
  "description": "Private reverse_ENV control-plane adapter for ruyiPage browser automation and evidence handoff",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check:python": "python -m py_compile bridge/ruyi_bridge.py scripts/runtime_ruyipage_1256.py scripts/runtime_capture_lifecycle.py scripts/runtime_attach_lifecycle.py scripts/runtime_download_behavior.py",
    "check:contract": "python scripts/contract_bridge.py",
    "check:runtime": "python scripts/runtime_ruyipage_1256.py",
    "check:capture-runtime": "python scripts/runtime_capture_lifecycle.py",
    "check:attach-runtime": "python scripts/runtime_attach_lifecycle.py",
    "check:download-runtime": "python scripts/runtime_download_behavior.py",
    "smoke": "node scripts/smoke-list-tools.mjs",
    "snapshot:tools": "npm run build && node scripts/smoke-list-tools.mjs --update-snapshot",
    "check:lifecycle": "node --test scripts/server-contract.test.mjs scripts/bridge-lifecycle.test.mjs scripts/stdio-lifecycle.test.mjs",
    "check": "npm run typecheck && npm run check:python && npm run check:contract && npm run build && npm run smoke && npm run check:lifecycle",
    "start": "node build/src/index.js",
    "dev": "tsc && node build/src/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ruyipage",
    "browser-automation",
    "firefox",
    "webdriver-bidi",
    "network-inspection",
    "fingerprinting",
    "session-handoff"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Facetomyself/ruyi-mcp-reverse-env.git"
  },
  "bugs": {
    "url": "https://github.com/Facetomyself/ruyi-mcp-reverse-env/issues"
  },
  "homepage": "https://github.com/Facetomyself/ruyi-mcp-reverse-env#readme"
}

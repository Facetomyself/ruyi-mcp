{
  "name": "ruyi-mcp",
  "version": "0.4.0",
  "description": "Firefox automation and native RDP debugging for Trace159",
  "license": "MIT",
  "type": "module",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check:python": "python -m py_compile bridge/ruyi_bridge.py scripts/runtime_ruyipage_1256.py scripts/runtime_capture_lifecycle.py scripts/runtime_attach_lifecycle.py scripts/runtime_download_behavior.py scripts/runtime_debugger.py scripts/runtime_agent_loop.py scripts/runtime_bidi_trace.py scripts/run-automation-gates.py",
    "check:debugger-runtime": "node scripts/rdp-runtime.mjs",
    "check:debugger-mcp-runtime": "node scripts/rdp-runtime.mjs",
    "check:rdp": "node --test scripts/rdp-transport.test.mjs scripts/rdp-source-maps.test.mjs scripts/runtime-firefox.test.mjs",
    "check:rdp-runtime": "node scripts/rdp-runtime.mjs",
    "check:rdp-intervention": "node scripts/rdp-intervention.mjs",
    "check:contract": "python scripts/contract_bridge.py",
    "check:runtime": "python scripts/runtime_ruyipage_1256.py",
    "check:capture-runtime": "python scripts/runtime_capture_lifecycle.py",
    "check:attach-runtime": "python scripts/runtime_attach_lifecycle.py",
    "check:download-runtime": "python scripts/runtime_download_behavior.py",
    "check:agent-runtime": "python scripts/runtime_agent_loop.py",
    "smoke": "node scripts/smoke-list-tools.mjs",
    "snapshot:tools": "npm run build && node scripts/smoke-list-tools.mjs --update-snapshot",
    "check:lifecycle": "node --test scripts/server-contract.test.mjs scripts/bridge-lifecycle.test.mjs scripts/stdio-lifecycle.test.mjs scripts/tool-registry.test.mjs scripts/borrowed-session.test.mjs scripts/debug-evidence.test.mjs && npm run check:borrowed-behaviors",
    "check:borrowed-behaviors": "node --test scripts/borrowed-behaviors.test.mjs",
    "check:borrowed-native": "node scripts/borrowed-behaviors-native.mjs",
    "check": "npm run typecheck && npm run check:python && npm run check:contract && npm run build && npm run smoke && npm run check:lifecycle && npm run check:rdp",
    "start": "node build/src/index.js",
    "dev": "tsc && node build/src/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ruyipage",
    "browser-automation",
    "firefox",
    "webdriver-bidi",
    "network-inspection",
    "fingerprinting",
    "session-handoff"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@jridgewell/trace-mapping": "0.3.31",
    "ajv": "8.20.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.8",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.18",
    "ip-address": "10.7.6",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Facetomyself/ruyi-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Facetomyself/ruyi-mcp/issues"
  },
  "homepage": "https://github.com/Facetomyself/ruyi-mcp#readme"
}
